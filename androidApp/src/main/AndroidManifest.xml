<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location for follow-me and map queries. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Microphone for STT. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Networking to reach the a11ybob backend. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The device is not required to have a camera / LIDAR sensor;
         those come later and are declared with uses-feature when added. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />

    <!-- Add these permission lines to your existing AndroidManifest.xml,
     inside the <manifest> tag and above the <application> tag -->

    <!-- Voice session: keep CPU running during STT/TTS -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- STT: on-device speech recognizer -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Location: FusedLocationProvider -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- API calls to a11ybob.com backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LidarAccessibilityApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LidarAccessibility"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LidarAccessibility.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
